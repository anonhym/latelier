{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "ignorePatterns": ["release"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 90
  },
  "mutate": [
    "electron/mongo/ejson.ts",
    "src/utils/ejson.ts",
    "electron/mongo/uri-parse.ts",
    "src/hooks/useRovingHighlight.ts",
    "src/hooks/useRovingFocus.ts",
    "src/hooks/useKeyboardMenuFocus.ts",
    "src/utils/contextMenuKey.ts",
    "src/pages/Workspace/views/docFieldFlatten.ts",
    "src/pages/Workspace/builder.ts",
    "src/pages/Workspace/deleteMode.ts",
    "src/pages/Workspace/collectionPatches.ts",
    "src/pages/Workspace/navigatorTreeReducer.ts",
    "src/pages/Workspace/resizeKeyStep.ts",
    "src/pages/Workspace/columnReorderFocus.ts",
    "src/pages/Workspace/filterTree.ts",
    "src/pages/Workspace/legacyBuilder.ts",
    "src/pages/Workspace/views/tableColumns.ts",
    "src/utils/displayValue.ts",
    "src/utils/shellSyntax.ts",
    "electron/log.ts",
    "electron/ipc/envelope.ts",
    "electron/ipc/senderGuard.ts",
    "electron/security/appLocation.ts",
    "electron/mongo/uri.ts"
  ]
}
