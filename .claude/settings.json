{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/check-renderer-purity.mjs:*)",
      "Bash(node scripts/gitnexus-autoindex.mjs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-renderer-purity.mjs",
            "statusMessage": "Checking renderer purity"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/gitnexus-autoindex.mjs",
            "statusMessage": "Refreshing GitNexus index",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
